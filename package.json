  },
  "description": "Skills for operating a Homebrew tap: set it up, then add, fix, triage, remove, and verify formulae and casks.",
  "devDependencies": {
    "ai-rulez": "5.7.0"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "skills/homebrew-add/SKILL.md",
    "skills/homebrew-add/index.md",
    "skills/homebrew-add/references/contract.md",
    "skills/homebrew-fix-formula/SKILL.md",
    "skills/homebrew-fix-formula/index.md",
    "skills/homebrew-fix-formula/references/contract.md",
    "skills/homebrew-fix-formula/references/repair-cases.md",
    "skills/homebrew-producer-dispatch/SKILL.md",
    "skills/homebrew-producer-dispatch/agents/openai.yaml",
    "skills/homebrew-producer-dispatch/index.md",
    "skills/homebrew-producer-dispatch/references/contract.md",
    "skills/homebrew-producer-dispatch/references/dispatch-cases.md",
    "skills/homebrew-producer-dispatch/references/dispatch-report.md",
    "skills/homebrew-producer-dispatch/scripts/bump_job.py",
    "skills/homebrew-producer-dispatch/scripts/classify_producer.py",
    "skills/homebrew-remove-or-deprecate/SKILL.md",
    "skills/homebrew-remove-or-deprecate/agents/openai.yaml",
    "skills/homebrew-remove-or-deprecate/index.md",
    "skills/homebrew-remove-or-deprecate/references/contract.md",
    "skills/homebrew-remove-or-deprecate/references/lifecycle-cases.md",
    "skills/homebrew-tap-setup/SKILL.md",
    "skills/homebrew-tap-setup/agents/openai.yaml",
    "skills/homebrew-tap-setup/index.md",
    "skills/homebrew-tap-setup/references/contract.md",
    "skills/homebrew-tap-setup/references/setup-cases.md",
    "skills/homebrew-tap-setup/references/setup-report.md",
    "skills/homebrew-update-triage/SKILL.md",
    "skills/homebrew-update-triage/index.md",
    "skills/homebrew-update-triage/references/contract.md",
    "skills/homebrew-update-triage/references/triage-cases.md",
    "skills/homebrew-update-triage/references/triage-report.md",
    "skills/homebrew-verify/SKILL.md",
    "skills/homebrew-verify/index.md",
    "skills/homebrew-verify/references/contract.md",
    "skills/homebrew-verify/references/verification-cases.md",
    "skills/homebrew-verify/references/verification-report.md",
    "README.md"
  ],
  "keywords": [
    "homebrew",
    "tap",
    "formula",
    "cask",
    "macos",
    "pi-package"
  ],
  "license": "MIT",
  "name": "homebrew-tap-skills",
  "pi": {
    "skills": [
      "./skills/homebrew-add",
      "./skills/homebrew-fix-formula",
      "./skills/homebrew-producer-dispatch",
      "./skills/homebrew-remove-or-deprecate",
      "./skills/homebrew-tap-setup",
      "./skills/homebrew-update-triage",
      "./skills/homebrew-verify"
    ],
    "prompts": []
  },
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/hasansezertasan/homebrew-tap-skills"
  },
  "scripts": {
    "check": "node scripts/check-repo.mjs && ai-rulez generate --check --no-self-mcp --strict-config && ai-rulez verify --plugin && ai-rulez validate --strict",
    "eval": "ai-rulez eval run --mode activation --surface retrieval --no-write",
    "generate": "ai-rulez generate --no-self-mcp --strict-config && ai-rulez generate --plugin",
    "test": "python -B -m unittest discover -s tests -v"
  },
  "version": "0.3.0"
}
